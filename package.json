{
  "name": "speech-translation-audio-app",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm -w server run dev\" \"npm -w client run dev -- --host\"",
    "dev:client": "npm -w client run dev",
    "dev:server": "npm -w server run dev",
    "build": "npm -w client run build",
    "start": "npm -w server run start"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "openai": "^6.16.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}

