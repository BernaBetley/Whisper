{
  "version": 2,
  "buildCommand": "npm -w client run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/translate-audio.js": {
      "runtime": "nodejs20.x",
      "maxDuration": 60
    },
    "api/health.js": {
      "runtime": "nodejs20.x"
    }
  }
}

